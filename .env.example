# Copy to .env (gitignored), or to ~/.microsoft-ads-mcp/.env, and fill in.
# Never commit real values.

# --- Required ---

# Application (client) ID of your Microsoft Entra app registration (a GUID).
MICROSOFT_ADS_CLIENT_ID=
# Developer token from Microsoft Advertising -> Settings -> Developer settings.
# Not needed in the sandbox (the universal sandbox token is used).
MICROSOFT_ADS_DEVELOPER_TOKEN=

# --- Optional ---

# production (default) or sandbox. They use separate credentials.
MICROSOFT_ADS_ENVIRONMENT=production
# Only for apps registered as Web apps with a client secret. Leave empty for desktop apps.
MICROSOFT_ADS_CLIENT_SECRET=
# Sign-in tenant: common (default) accepts work, school and personal Microsoft accounts.
MICROSOFT_ADS_TENANT=common

# `microsoft-ads-mcp auth` saves the refresh token to
# ~/.microsoft-ads-mcp/secrets/microsoft-ads-token.json (owner-only). Override here,
# or put the refresh token itself in MICROSOFT_ADS_REFRESH_TOKEN (prefer the file).
MICROSOFT_ADS_TOKEN_FILE=
MICROSOFT_ADS_REFRESH_TOKEN=

# Default account and customer (manager account). Tools also take account_id/customer_id.
MICROSOFT_ADS_ACCOUNT_ID=
MICROSOFT_ADS_CUSTOMER_ID=

# Start in dry-run: writes are logged and previewed but NOT sent.
MICROSOFT_ADS_DRY_RUN=true
# Register only read-only tools.
MICROSOFT_ADS_READ_ONLY=false
# Only register some tool groups, e.g. accounts,campaigns,keywords,reporting
MICROSOFT_ADS_TOOL_GROUPS=

# Safety limits: writes beyond these need confirm='APPLY'.
MICROSOFT_ADS_BULK_THRESHOLD=10
MICROSOFT_ADS_MAX_INCREASE_PCT=20
# Optional absolute caps in the account currency (blank = no cap).
MICROSOFT_ADS_MAX_DAILY_BUDGET=
MICROSOFT_ADS_MAX_BID=

# Audit log of writes (default ~/.microsoft-ads-mcp/logs/audit.jsonl) and retention (0 = forever).
MICROSOFT_ADS_AUDIT_LOG=
MICROSOFT_ADS_AUDIT_RETENTION_DAYS=30
# Largest report or bulk file to download, in MB.
MICROSOFT_ADS_MAX_DOWNLOAD_MB=200

MICROSOFT_ADS_TIMEOUT=60
MICROSOFT_ADS_LOG_LEVEL=INFO

# stdio (default) or streamable-http (served at /mcp). HTTP has no sign-in: keep it on
# 127.0.0.1. Other hosts are refused unless MICROSOFT_ADS_ALLOW_REMOTE=true.
MICROSOFT_ADS_TRANSPORT=stdio
MICROSOFT_ADS_HOST=127.0.0.1
MICROSOFT_ADS_PORT=8000
MICROSOFT_ADS_ALLOW_REMOTE=false
